{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "cd client && npm install && npm run build",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "client/dist" } },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}